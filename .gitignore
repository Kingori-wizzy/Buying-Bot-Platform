!artifacts/BUILD_METADATA.example.json
backups/

# Logs and debug
logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test and coverage
coverage/
.nyc_output/
playwright-report/
test-results/

# Python (future AI / worker services)
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# OS
.DS_Store
Thumbs.db
Desktop.ini

# IDE / editors
.idea/
*.swp
*.swo
*~

# Local tooling
*.local
.cache/
tmp/
temp/

