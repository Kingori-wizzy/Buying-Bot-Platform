{
  "name": "buying-bot-platform",
  "version": "0.1.0-rc.3",
  "private": true,
  "description": "Buying Bot Platform — AI-powered omnichannel commerce monorepo",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "prettier": "@buying-bot/prettier-config",
  "scripts": {
    "prepare": "husky",
    "check:node": "node ./scripts/check-node.mjs",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "pnpm run build --filter=\"./packages/*\" && eslint . --max-warnings=0",
    "lint:fix": "pnpm run build --filter=\"./packages/*\" && eslint . --fix --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "audit:deps": "pnpm audit --audit-level=high",
    "verify": "pnpm run check:node && pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build && pnpm run audit:deps",
    "commitlint": "commitlint --edit",
    "smoke": "node ./scripts/smoke/staging-smoke.mjs",
    "integrity": "node ./scripts/integrity/check-data-integrity.mjs",
    "verify:sandbox-marketplace": "node --env-file=.env ./scripts/dev/verify-sandbox-marketplace.mjs",
    "sync:mock-products": "node --env-file=.env ./scripts/dev/sync-mock-products.mjs",
    "security:gate": "node ./scripts/security/security-gate.mjs",
    "vps:preflight": "bash ./scripts/vps/preflight.sh",
    "production:preflight": "node ./scripts/deployment/production-preflight.mjs",
    "production:bootstrap-env": "node ./scripts/deployment/bootstrap-env.mjs",
    "production:smoke": "node ./scripts/deployment/post-deploy-smoke.mjs",
    "test:e2e": "playwright test -c ./e2e/playwright.config.ts",
    "migrate:deploy": "pnpm --filter @buying-bot/database exec prisma migrate deploy",
    "staging:up": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/staging/up.ps1",
    "staging:up:sh": "bash ./scripts/staging/up.sh",
    "release:metadata": "node ./scripts/release/generate-build-metadata.mjs",
    "preflight": "pnpm run verify && pnpm run security:gate && pnpm run integrity"
  },
  "devDependencies": {
    "@buying-bot/eslint-config": "workspace:*",
    "@buying-bot/prettier-config": "workspace:*",
    "@buying-bot/typescript-config": "workspace:*",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@playwright/test": "^1.54.2",
    "eslint": "^9.32.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "prettier": "^3.6.2",
    "turbo": "^2.5.4",
    "typescript": "^7.0.2"
  },
  "pnpm": {
    "overrides": {
      "effect": ">=3.20.0",
      "sharp": ">=0.35.0",
      "postcss": ">=8.5.18",
      "deepmerge-ts": "^8.0.1",
      "fast-xml-parser": ">=4.5.5"
    }
  }
}
