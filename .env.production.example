# Buying Bot Platform — PRODUCTION environment template (Hostinger VPS)
# Copy to a root-only path, e.g. /etc/buyingbot/env.production (chmod 600).
# NEVER commit real values. Fail-closed validation rejects missing secrets.

# --- Runtime ---
NODE_ENV=production
LOG_LEVEL=info
TZ=Africa/Nairobi

# --- Compose DB/Redis (internal) ---
POSTGRES_USER=buyingbot
# POSTGRES_PASSWORD=   # openssl rand -base64 32
POSTGRES_DB=buyingbot
# REDIS_PASSWORD=      # openssl rand -base64 32
# DATABASE_URL is injected by Compose; override only for external managed DB:
# DATABASE_URL=postgresql://buyingbot:PASSWORD@postgres:5432/buyingbot?schema=public&connection_limit=20
# REDIS_URL=redis://:PASSWORD@redis:6379

# --- API ---
SERVICE_NAME=api
HOST=0.0.0.0
PORT=3000
# CORS_ORIGIN=https://buybot.staging.earnhub.com
# SESSION_SECRET=        # openssl rand -base64 48
# SERVICE_JWT_SECRET=    # openssl rand -base64 48
COOKIE_SECURE=true
ADMIN_MFA_REQUIRED=true
CUSTOMER_SESSION_COOKIE=bb_cust_session
ADMIN_SESSION_COOKIE=bb_admin_session
CSRF_COOKIE=bb_csrf
GUEST_CART_COOKIE=bb_guest_cart

# --- Public URLs (single staging/production host — path-based nginx) ---
# Shop /, admin /admin/, API /v1/ on one hostname until dedicated hosts exist.
# SHOP_DOMAIN=buybot.staging.earnhub.com
# ADMIN_DOMAIN=buybot.staging.earnhub.com
# API_DOMAIN=buybot.staging.earnhub.com
# PUBLIC_WEB_URL=https://buybot.staging.earnhub.com
# PUBLIC_ADMIN_URL=https://buybot.staging.earnhub.com/admin
# PUBLIC_API_URL=https://buybot.staging.earnhub.com
# NEXT_PUBLIC_API_BASE_URL=https://buybot.staging.earnhub.com
# PUBLIC_API_BASE_URL=https://buybot.staging.earnhub.com
# MEDIA_PUBLIC_BASE_URL=https://buybot.staging.earnhub.com/v1/media/files
# CORS_ORIGIN must be the exact HTTPS origin (no wildcard). Example:
# CORS_ORIGIN=https://buybot.staging.earnhub.com
#
# Auth notes (after migrate + first API boot seeds org/roles):
# - Customer register/login: storefront /register and /login (password min 10).
# - Admin: create with scripts/deployment/create-admin.mjs then login at /admin
#   with realm=admin. Do not reuse development passwords.

# --- Commerce ---
DEFAULT_CURRENCY=KES
TAX_REQUIRED=true
# TAX_DEFAULT_RATE_BPS=1600
TAX_POLICY_CODE=DEFAULT
SHIPPING_DEFAULT_CODE=FLAT
PAYMENTS_ENABLED=false
PAYMENT_PROVIDER=escrow

# Escrow — EXTERNAL PREREQUISITE (enable PAYMENTS_ENABLED only when set)
# ESCROW_API_KEY=
# ESCROW_API_SECRET=
# ESCROW_BASE_URL=https://escrow.provider.example
# ESCROW_WEBHOOK_SECRET=
# ESCROW_ALLOW_TEST_DOUBLE=false

# M-Pesa — DEFERRED (not customer UX)
# MPESA_ENABLED=false

# --- Object storage (MinIO on VPS) ---
MEDIA_DRIVER=s3
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=buyingbot-media
# S3_ACCESS_KEY_ID=     # alias: S3_ACCESS_KEY — also MINIO_ROOT_USER
# S3_SECRET_ACCESS_KEY= # alias: S3_SECRET_KEY — also MINIO_ROOT_PASSWORD (min 8 chars)
S3_FORCE_PATH_STYLE=true

# --- AI (fail closed if unavailable) ---
AI_PROVIDER=deterministic
# AI_PROVIDER=ollama
# OLLAMA_BASE_URL=http://ollama:11434
# OLLAMA_MODEL=mistral
# OPENAI_API_KEY=
# AI_SERVICE_BASE_URL=http://ai-service:3003
# API_BASE_URL=http://api:3000

# --- Notifications (EXTERNAL) ---
# SMTP_URL=
# SMS_PROVIDER_API_KEY=
# WHATSAPP_TOKEN=

# --- TLS / nginx host paths ---
# TLS_CERT_HOST_DIR=/etc/letsencrypt/live/example.com
# HTTP_PORT=80
# HTTPS_PORT=443
# BUYINGBOT_ENV_FILE=/etc/buyingbot/env.production

# --- Catalog / marketplace (deferred) ---
# Production shop must not ingest external marketplace feeds by default.
MARKETPLACE_INGESTION_ENABLED=false

# --- Observability ---
# OTEL_EXPORTER_OTLP_ENDPOINT=
# BACKUP_AGE_RECIPIENT=
