# Buying Bot Platform — PRODUCTION environment template
# Copy to `.env.production` on the host via secrets manager. NEVER commit real values.
# Fail-closed: production boot rejects missing SESSION_SECRET / DATABASE_URL / CORS_ORIGIN.

# --- Runtime ---
NODE_ENV=production
LOG_LEVEL=info
DEBUG=false

# --- Postgres (EXTERNAL managed instance) ---
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/buyingbot?schema=public

# --- Redis (EXTERNAL) ---
# REDIS_URL=redis://HOST:6379

# --- API ---
SERVICE_NAME=api
HOST=0.0.0.0
PORT=3000
# Production must NOT use wildcard CORS.
# CORS_ORIGIN=https://shop.example.com,https://admin.example.com
# SESSION_SECRET=  # openssl rand -base64 48
# SERVICE_JWT_SECRET=
COOKIE_SECURE=true
CUSTOMER_SESSION_COOKIE=bb_cust_session
ADMIN_SESSION_COOKIE=bb_admin_session
CSRF_COOKIE=bb_csrf
GUEST_CART_COOKIE=bb_guest_cart

# Commerce — keep payments disabled until live Daraja + legal gates
DEFAULT_CURRENCY=KES
TAX_REQUIRED=true
# TAX_DEFAULT_RATE_BPS=  # fail-closed if TAX_REQUIRED and unset
TAX_POLICY_CODE=DEFAULT
SHIPPING_DEFAULT_CODE=FLAT
PAYMENTS_ENABLED=false
# MPESA_ENV=production
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=
# MPESA_PASSKEY=
# MPESA_CALLBACK_URL=https://api.example.com/v1/webhooks/payments/mpesa
# MPESA_WEBHOOK_SECRET=

PRODUCT_CACHE_TTL_SECONDS=60

# --- Worker ---
# OUTBOX_POLL_INTERVAL_MS=5000
# RESERVATION_EXPIRE_INTERVAL_MS=30000
# PAYMENT_RECONCILE_INTERVAL_MS=60000

# --- AI ---
AI_PROVIDER=openai
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# API_BASE_URL=http://api:3000
# AI_SERVICE_BASE_URL=http://ai-service:3003

# --- Frontends ---
# NEXT_PUBLIC_API_BASE_URL=https://api.example.com

# --- Notifications (EXTERNAL adapters) ---
# SMTP_URL=
# SMS_PROVIDER_API_KEY=
# WHATSAPP_TOKEN=

# --- Object storage (EXTERNAL) ---
# S3_BUCKET=
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- Observability ---
# OTEL_EXPORTER_OTLP_ENDPOINT=
