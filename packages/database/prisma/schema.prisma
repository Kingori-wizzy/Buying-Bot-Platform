generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["identity", "audit", "catalog", "inventory", "promotions", "cart", "orders", "payments", "integrations", "ai", "notifications"]
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  LOCKED
  DEACTIVATED
  DELETED
  COMPROMISED

  @@schema("identity")
}

enum CredentialType {
  PASSWORD
  OAUTH
  WEBAUTHN

  @@schema("identity")
}

enum SessionRealm {
  CUSTOMER
  ADMIN

  @@schema("identity")
}

enum MfaFactorType {
  TOTP

  @@schema("identity")
}

enum ProductLifecycle {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  INACTIVE
  ARCHIVED

  @@schema("catalog")
}

enum MediaAssetStatus {
  PENDING
  READY
  FAILED
  DELETED

  @@schema("catalog")
}

enum InventoryMovementType {
  ADJUSTMENT
  RECEIPT
  RESERVATION
  SALE
  RELEASE
  RETURN
  DAMAGE

  @@schema("inventory")
}

enum ReservationStatus {
  HELD
  COMMITTED
  RELEASED
  EXPIRED

  @@schema("inventory")
}

enum CartStatus {
  ACTIVE
  ABANDONED
  EXPIRED
  CONVERTED

  @@schema("cart")
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  CANCELLED
  FAILED
  RECONCILIATION_HOLD

  @@schema("orders")
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED

  @@schema("orders")
}

enum PaymentStatus {
  PENDING
  INITIATED
  CONFIRMED
  FAILED
  CANCELLED

  @@schema("payments")
}

enum PaymentAttemptStatus {
  CREATED
  INITIATED
  CONFIRMED
  FAILED
  EXPIRED

  @@schema("payments")
}

enum PaymentTransactionType {
  CHARGE
  REFUND

  @@schema("payments")
}

enum PaymentTransactionStatus {
  PENDING
  CONFIRMED
  FAILED

  @@schema("payments")
}

enum PromotionType {
  PERCENT_OFF_ITEM
  FIXED_OFF_ITEM
  PERCENT_OFF_CART
  FIXED_OFF_CART

  @@schema("promotions")
}

enum CouponStatus {
  ACTIVE
  DISABLED
  EXPIRED

  @@schema("promotions")
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String
  emailNormalized String     @unique @map("email_normalized")
  status          UserStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  credentials             Credential[]
  sessions                Session[]
  memberships             Membership[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  mfaFactors              MfaFactor[]
  mfaRecoveryCodes        MfaRecoveryCode[]
  securityEvents          SecurityEvent[]
  carts                   Cart[]
  orders                  Order[]
  couponRedemptions       CouponRedemption[]
  conversations           Conversation[]

  @@index([emailNormalized])
  @@map("users")
  @@schema("identity")
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships Membership[]
  offers      Offer[]

  @@map("organizations")
  @@schema("identity")
}

model Membership {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  roles        MembershipRole[]

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("memberships")
  @@schema("identity")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  permissions RolePermission[]
  memberships MembershipRole[]

  @@map("roles")
  @@schema("identity")
}

model Permission {
  id        String   @id @default(uuid()) @db.Uuid
  resource  String
  action    String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  roles RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
  @@schema("identity")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
  @@schema("identity")
}

model MembershipRole {
  membershipId String @map("membership_id") @db.Uuid
  roleId       String @map("role_id") @db.Uuid

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([membershipId, roleId])
  @@map("membership_roles")
  @@schema("identity")
}

model Credential {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  type       CredentialType
  secretHash String         @map("secret_hash")
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("credentials")
  @@schema("identity")
}

model Session {
  id                String       @id @default(uuid()) @db.Uuid
  userId            String       @map("user_id") @db.Uuid
  realm             SessionRealm
  tokenHash         String       @unique @map("token_hash")
  expiresAt         DateTime     @map("expires_at") @db.Timestamptz(3)
  absoluteExpiresAt DateTime     @map("absolute_expires_at") @db.Timestamptz(3)
  revokedAt         DateTime?    @map("revoked_at") @db.Timestamptz(3)
  ip                String?
  userAgent         String?      @map("user_agent")
  mfaSatisfiedAt    DateTime?    @map("mfa_satisfied_at") @db.Timestamptz(3)
  steppedUpAt       DateTime?    @map("stepped_up_at") @db.Timestamptz(3)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, realm])
  @@index([expiresAt])
  @@map("sessions")
  @@schema("identity")
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
  @@schema("identity")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
  @@schema("identity")
}

model MfaFactor {
  id              String        @id @default(uuid()) @db.Uuid
  userId          String        @map("user_id") @db.Uuid
  type            MfaFactorType
  secretEncrypted String        @map("secret_encrypted")
  verifiedAt      DateTime?     @map("verified_at") @db.Timestamptz(3)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("mfa_factors")
  @@schema("identity")
}

model MfaRecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mfa_recovery_codes")
  @@schema("identity")
}

model SecurityEvent {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String?  @map("user_id") @db.Uuid
  type          String
  ip            String?
  userAgent     String?  @map("user_agent")
  metadata      Json?
  correlationId String?  @map("correlation_id")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@map("security_events")
  @@schema("audit")
}

// ─── Catalog ─────────────────────────────────────────────────────────────────

model Brand {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  slug        String    @unique
  description String?
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  products Product[]

  @@map("brands")
  @@schema("catalog")
}

model Category {
  id          String    @id @default(uuid()) @db.Uuid
  parentId    String?   @map("parent_id") @db.Uuid
  name        String
  slug        String    @unique
  description String?
  sortOrder   Int       @default(0) @map("sort_order")
  active      Boolean   @default(true)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  parent           Category? @relation("CategoryTree", fields: [parentId], references: [id])
  children         Category[] @relation("CategoryTree")
  primaryProducts  Product[]  @relation("PrimaryCategory")

  @@index([parentId])
  @@map("categories")
  @@schema("catalog")
}

model AttributeDefinition {
  id            String   @id @default(uuid()) @db.Uuid
  code          String   @unique
  name          String
  dataType      String   @map("data_type")
  isVariantAxis Boolean  @default(false) @map("is_variant_axis")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  values ProductAttributeValue[]

  @@map("attribute_definitions")
  @@schema("catalog")
}

model Product {
  id                String           @id @default(uuid()) @db.Uuid
  name              String
  slug              String           @unique
  shortDescription  String?          @map("short_description")
  description       String?
  status            ProductLifecycle @default(DRAFT)
  brandId           String?          @map("brand_id") @db.Uuid
  primaryCategoryId String?          @map("primary_category_id") @db.Uuid
  seoTitle          String?          @map("seo_title")
  seoDescription    String?          @map("seo_description")
  deletedAt         DateTime?        @map("deleted_at") @db.Timestamptz(3)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  brand           Brand?                  @relation(fields: [brandId], references: [id])
  primaryCategory Category?               @relation("PrimaryCategory", fields: [primaryCategoryId], references: [id])
  variants        Variant[]
  attributeValues ProductAttributeValue[]
  media           ProductMedia[]
  searchDocument  ProductSearchDocument?

  @@index([status])
  @@index([brandId])
  @@index([primaryCategoryId])
  @@map("products")
  @@schema("catalog")
}

model ProductAttributeValue {
  id                    String @id @default(uuid()) @db.Uuid
  productId             String @map("product_id") @db.Uuid
  attributeDefinitionId String @map("attribute_definition_id") @db.Uuid
  valueText             String @map("value_text")

  product             Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeDefinition AttributeDefinition @relation(fields: [attributeDefinitionId], references: [id], onDelete: Cascade)

  @@unique([productId, attributeDefinitionId])
  @@map("product_attribute_values")
  @@schema("catalog")
}

model Variant {
  id         String    @id @default(uuid()) @db.Uuid
  productId  String    @map("product_id") @db.Uuid
  name       String
  optionJson Json?     @map("option_json")
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  product Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku     Sku?
  media   VariantMedia[]

  @@index([productId])
  @@map("variants")
  @@schema("catalog")
}

model Sku {
  id          String    @id @default(uuid()) @db.Uuid
  variantId   String    @unique @map("variant_id") @db.Uuid
  internalSku String    @unique @map("internal_sku")
  sellerSku   String?   @map("seller_sku")
  barcode     String?
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  variant            Variant             @relation(fields: [variantId], references: [id], onDelete: Cascade)
  offers             Offer[]
  inventoryBalances  InventoryBalance[]
  inventoryMovements InventoryMovement[]
  reservations       Reservation[]
  cartLines          CartLine[]

  @@map("skus")
  @@schema("catalog")
}

model Offer {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  skuId           String    @map("sku_id") @db.Uuid
  listPriceMinor  Int       @map("list_price_minor")
  currency        String
  taxInclusive    Boolean   @default(true) @map("tax_inclusive")
  taxClass        String?   @map("tax_class")
  active          Boolean   @default(true)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization  @relation(fields: [organizationId], references: [id])
  sku          Sku           @relation(fields: [skuId], references: [id])
  priceWindows PriceWindow[]
  cartLines    CartLine[]

  @@index([skuId, active])
  @@index([organizationId])
  @@map("offers")
  @@schema("catalog")
}

model PriceWindow {
  id             String    @id @default(uuid()) @db.Uuid
  offerId        String    @map("offer_id") @db.Uuid
  salePriceMinor Int       @map("sale_price_minor")
  startsAt       DateTime  @map("starts_at") @db.Timestamptz(3)
  endsAt         DateTime? @map("ends_at") @db.Timestamptz(3)
  priority       Int       @default(0)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@index([offerId, startsAt, endsAt])
  @@map("price_windows")
  @@schema("catalog")
}

model MediaAsset {
  id        String           @id @default(uuid()) @db.Uuid
  objectKey String           @map("object_key")
  mimeType  String           @map("mime_type")
  status    MediaAssetStatus @default(PENDING)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  productMedia ProductMedia[]
  variantMedia VariantMedia[]

  @@map("media_assets")
  @@schema("catalog")
}

model ProductMedia {
  productId    String @map("product_id") @db.Uuid
  mediaAssetId String @map("media_asset_id") @db.Uuid
  sortOrder    Int    @default(0) @map("sort_order")

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@id([productId, mediaAssetId])
  @@map("product_media")
  @@schema("catalog")
}

model VariantMedia {
  variantId    String @map("variant_id") @db.Uuid
  mediaAssetId String @map("media_asset_id") @db.Uuid
  sortOrder    Int    @default(0) @map("sort_order")

  variant    Variant    @relation(fields: [variantId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@id([variantId, mediaAssetId])
  @@map("variant_media")
  @@schema("catalog")
}

model ProductSearchDocument {
  productId String   @id @map("product_id") @db.Uuid
  document  String
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_search_documents")
  @@schema("catalog")
}

// ─── Inventory ───────────────────────────────────────────────────────────────

model Location {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  balances   InventoryBalance[]
  movements  InventoryMovement[]
  reservations Reservation[]

  @@map("locations")
  @@schema("inventory")
}

model InventoryBalance {
  id         String   @id @default(uuid()) @db.Uuid
  skuId      String   @map("sku_id") @db.Uuid
  locationId String   @map("location_id") @db.Uuid
  onHand     Int      @default(0) @map("on_hand")
  reserved   Int      @default(0)
  version    Int      @default(0)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  sku      Sku      @relation(fields: [skuId], references: [id])
  location Location @relation(fields: [locationId], references: [id])

  @@unique([skuId, locationId])
  @@map("inventory_balances")
  @@schema("inventory")
}

model InventoryMovement {
  id             String                @id @default(uuid()) @db.Uuid
  skuId          String                @map("sku_id") @db.Uuid
  locationId     String                @map("location_id") @db.Uuid
  type           InventoryMovementType
  quantity       Int
  reason         String?
  idempotencyKey String                @unique @map("idempotency_key")
  actorId        String?               @map("actor_id") @db.Uuid
  correlationId  String?               @map("correlation_id")
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  sku      Sku      @relation(fields: [skuId], references: [id])
  location Location @relation(fields: [locationId], references: [id])

  @@index([skuId, locationId, createdAt])
  @@map("inventory_movements")
  @@schema("inventory")
}

model Reservation {
  id         String            @id @default(uuid()) @db.Uuid
  skuId      String            @map("sku_id") @db.Uuid
  locationId String            @map("location_id") @db.Uuid
  quantity   Int
  status     ReservationStatus @default(HELD)
  expiresAt  DateTime          @map("expires_at") @db.Timestamptz(3)
  orderId    String?           @map("order_id") @db.Uuid
  cartId     String?           @map("cart_id") @db.Uuid
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  sku      Sku      @relation(fields: [skuId], references: [id])
  location Location @relation(fields: [locationId], references: [id])

  @@index([status, expiresAt])
  @@index([orderId])
  @@index([cartId])
  @@map("reservations")
  @@schema("inventory")
}

// ─── Promotions ──────────────────────────────────────────────────────────────

model Promotion {
  id              String        @id @default(uuid()) @db.Uuid
  code            String?       @unique
  name            String
  type            PromotionType
  percentBps      Int?          @map("percent_bps")
  amountMinor     Int?          @map("amount_minor")
  currency        String?
  stackable       Boolean       @default(false)
  priority        Int           @default(0)
  minSpendMinor   Int?          @map("min_spend_minor")
  active          Boolean       @default(true)
  startsAt        DateTime?     @map("starts_at") @db.Timestamptz(3)
  endsAt          DateTime?     @map("ends_at") @db.Timestamptz(3)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  coupons Coupon[]

  @@map("promotions")
  @@schema("promotions")
}

model Coupon {
  id             String       @id @default(uuid()) @db.Uuid
  code           String       @unique
  promotionId    String       @map("promotion_id") @db.Uuid
  status         CouponStatus @default(ACTIVE)
  maxRedemptions Int?         @map("max_redemptions")
  redeemedCount  Int          @default(0) @map("redeemed_count")
  startsAt       DateTime?    @map("starts_at") @db.Timestamptz(3)
  endsAt         DateTime?    @map("ends_at") @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  promotion   Promotion          @relation(fields: [promotionId], references: [id])
  redemptions CouponRedemption[]

  @@map("coupons")
  @@schema("promotions")
}

model CouponRedemption {
  id        String   @id @default(uuid()) @db.Uuid
  couponId  String   @map("coupon_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  orderId   String?  @map("order_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  coupon Coupon @relation(fields: [couponId], references: [id])
  user   User?  @relation(fields: [userId], references: [id])

  @@unique([couponId, orderId])
  @@index([userId])
  @@map("coupon_redemptions")
  @@schema("promotions")
}

model TaxPolicy {
  id             String   @id @default(uuid()) @db.Uuid
  code           String   @unique
  name           String
  defaultRateBps Int      @map("default_rate_bps")
  currency       String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  rates TaxRate[]

  @@map("tax_policies")
  @@schema("promotions")
}

model TaxRate {
  id          String   @id @default(uuid()) @db.Uuid
  taxPolicyId String   @map("tax_policy_id") @db.Uuid
  taxClass    String   @map("tax_class")
  rateBps     Int      @map("rate_bps")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  taxPolicy TaxPolicy @relation(fields: [taxPolicyId], references: [id], onDelete: Cascade)

  @@unique([taxPolicyId, taxClass])
  @@map("tax_rates")
  @@schema("promotions")
}

model ShippingMethodConfig {
  id                 String   @id @default(uuid()) @db.Uuid
  code               String   @unique
  name               String
  currency           String
  flatRateMinor      Int      @map("flat_rate_minor")
  freeAboveMinor     Int?     @map("free_above_minor")
  active             Boolean  @default(true)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("shipping_method_configs")
  @@schema("promotions")
}

// ─── Cart ────────────────────────────────────────────────────────────────────

model Cart {
  id             String     @id @default(uuid()) @db.Uuid
  userId         String?    @map("user_id") @db.Uuid
  guestTokenHash String?    @map("guest_token_hash")
  status         CartStatus @default(ACTIVE)
  currency       String
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  user  User?      @relation(fields: [userId], references: [id])
  lines CartLine[]

  @@index([userId, status])
  @@index([guestTokenHash])
  @@map("carts")
  @@schema("cart")
}

model CartLine {
  id        String   @id @default(uuid()) @db.Uuid
  cartId    String   @map("cart_id") @db.Uuid
  offerId   String   @map("offer_id") @db.Uuid
  skuId     String   @map("sku_id") @db.Uuid
  quantity  Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  cart  Cart  @relation(fields: [cartId], references: [id], onDelete: Cascade)
  offer Offer @relation(fields: [offerId], references: [id])
  sku   Sku   @relation(fields: [skuId], references: [id])

  @@unique([cartId, offerId])
  @@map("cart_lines")
  @@schema("cart")
}

// ─── Orders ──────────────────────────────────────────────────────────────────

model IdempotencyRecord {
  id           String   @id @default(uuid()) @db.Uuid
  key          String
  actorKey     String   @map("actor_key")
  requestHash  String?  @map("request_hash")
  responseJson Json?    @map("response_json")
  statusCode   Int?     @map("status_code")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([key, actorKey])
  @@map("idempotency_records")
  @@schema("orders")
}

model Order {
  id             String      @id @default(uuid()) @db.Uuid
  userId         String?     @map("user_id") @db.Uuid
  status         OrderStatus @default(PENDING_PAYMENT)
  currency       String
  payableMinor   Int         @map("payable_minor")
  cartId         String?     @map("cart_id") @db.Uuid
  reservationId  String?     @map("reservation_id") @db.Uuid
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  user               User?                   @relation(fields: [userId], references: [id])
  items              OrderItem[]
  financialSnapshot  OrderFinancialSnapshot?
  payments           Payment[]

  @@index([userId, createdAt])
  @@index([status])
  @@map("orders")
  @@schema("orders")
}

model OrderItem {
  id              String @id @default(uuid()) @db.Uuid
  orderId         String @map("order_id") @db.Uuid
  productId       String @map("product_id") @db.Uuid
  productName     String @map("product_name")
  variantName     String? @map("variant_name")
  skuCode         String @map("sku_code")
  offerId         String @map("offer_id") @db.Uuid
  organizationId  String @map("organization_id") @db.Uuid
  quantity        Int
  unitPriceMinor  Int    @map("unit_price_minor")
  currency        String
  lineDiscountMinor Int  @default(0) @map("line_discount_minor")
  taxMinor        Int    @default(0) @map("tax_minor")
  lineTotalMinor  Int    @map("line_total_minor")
  taxClass        String? @map("tax_class")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_items")
  @@schema("orders")
}

model OrderFinancialSnapshot {
  orderId          String @id @map("order_id") @db.Uuid
  calculationJson  Json   @map("calculation_json")
  goodsMinor       Int    @map("goods_minor")
  discountMinor    Int    @map("discount_minor")
  shippingMinor    Int    @map("shipping_minor")
  taxMinor         Int    @map("tax_minor")
  payableMinor     Int    @map("payable_minor")
  currency         String
  calculationVersion String @map("calculation_version")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_financial_snapshots")
  @@schema("orders")
}

model OutboxMessage {
  id            String       @id @default(uuid()) @db.Uuid
  type          String
  payloadJson   Json         @map("payload_json")
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  availableAt   DateTime     @default(now()) @map("available_at") @db.Timestamptz(3)
  publishedAt   DateTime?    @map("published_at") @db.Timestamptz(3)
  lastError     String?      @map("last_error")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, availableAt])
  @@map("outbox_messages")
  @@schema("orders")
}

// ─── Payments ────────────────────────────────────────────────────────────────

model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  orderId        String        @map("order_id") @db.Uuid
  provider       String
  status         PaymentStatus @default(PENDING)
  amountMinor    Int           @map("amount_minor")
  currency       String
  msisdnE164     String?       @map("msisdn_e164")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  order        Order               @relation(fields: [orderId], references: [id])
  attempts     PaymentAttempt[]
  transactions PaymentTransaction[]

  @@index([orderId])
  @@map("payments")
  @@schema("payments")
}

model PaymentAttempt {
  id                   String               @id @default(uuid()) @db.Uuid
  paymentId            String               @map("payment_id") @db.Uuid
  status               PaymentAttemptStatus @default(CREATED)
  providerReference    String?              @map("provider_reference")
  providerCheckoutId   String?              @map("provider_checkout_id")
  initiatedAt          DateTime?            @map("initiated_at") @db.Timestamptz(3)
  confirmedAt          DateTime?            @map("confirmed_at") @db.Timestamptz(3)
  failureReason        String?              @map("failure_reason")
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, status])
  @@index([providerReference])
  @@map("payment_attempts")
  @@schema("payments")
}

model PaymentTransaction {
  id                String                    @id @default(uuid()) @db.Uuid
  paymentId         String                    @map("payment_id") @db.Uuid
  type              PaymentTransactionType
  status            PaymentTransactionStatus  @default(PENDING)
  amountMinor       Int                       @map("amount_minor")
  currency          String
  providerTxnId     String?                   @unique @map("provider_txn_id")
  rawPayloadJson    Json?                     @map("raw_payload_json")
  createdAt         DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@map("payment_transactions")
  @@schema("payments")
}

model WebhookReceipt {
  id              String    @id @default(uuid()) @db.Uuid
  provider        String
  eventId         String    @map("event_id")
  signatureValid  Boolean   @map("signature_valid")
  payloadHash     String    @map("payload_hash")
  payloadJson     Json      @map("payload_json")
  processedAt     DateTime? @map("processed_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([provider, eventId])
  @@index([createdAt])
  @@map("webhook_receipts")
  @@schema("integrations")
}

// ─── AI / Knowledge (ADR-0015 / ADR-0006 pgvector) ───────────────────────────

enum KnowledgeDocumentStatus {
  PENDING
  PROCESSING
  READY
  FAILED

  @@schema("ai")
}

enum ConversationRealm {
  CUSTOMER
  ADMIN

  @@schema("ai")
}

model KnowledgeDocument {
  id         String                  @id @default(uuid()) @db.Uuid
  sourceType String                  @map("source_type")
  title      String
  uri        String?
  objectKey  String?                 @map("object_key")
  checksum   String
  version    Int                     @default(1)
  status     KnowledgeDocumentStatus @default(PENDING)
  metadata   Json                    @default("{}")
  createdAt  DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  chunks KnowledgeChunk[]

  @@index([status, updatedAt])
  @@map("knowledge_documents")
  @@schema("ai")
}

model KnowledgeChunk {
  id          String   @id @default(uuid()) @db.Uuid
  documentId  String   @map("document_id") @db.Uuid
  ordinal     Int
  content     String
  contentHash String   @map("content_hash")
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  document   KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  embeddings Embedding[]

  @@unique([documentId, ordinal])
  @@index([contentHash])
  @@map("knowledge_chunks")
  @@schema("ai")
}

model Embedding {
  id        String                       @id @default(uuid()) @db.Uuid
  chunkId   String                       @map("chunk_id") @db.Uuid
  model     String
  dims      Int
  embedding Unsupported("vector(1536)")?
  createdAt DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)

  chunk KnowledgeChunk @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  @@index([chunkId, model])
  @@map("embeddings")
  @@schema("ai")
}

model SearchSynonym {
  id        String   @id @default(uuid()) @db.Uuid
  term      String
  synonym   String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([term, synonym])
  @@map("search_synonyms")
  @@schema("ai")
}

model SearchAnalyticsEvent {
  id        String   @id @default(uuid()) @db.Uuid
  eventType String   @map("event_type")
  query     String?
  productId String?  @map("product_id") @db.Uuid
  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([eventType, createdAt])
  @@index([productId])
  @@map("search_analytics_events")
  @@schema("ai")
}

model Conversation {
  id        String            @id @default(uuid()) @db.Uuid
  userId    String            @map("user_id") @db.Uuid
  realm     ConversationRealm @default(CUSTOMER)
  title     String?
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ConversationMessage[]

  @@index([userId, updatedAt])
  @@map("conversations")
  @@schema("ai")
}

model ConversationMessage {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  role           String
  content        String
  toolName       String?  @map("tool_name")
  citationsJson  Json?    @map("citations_json")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("conversation_messages")
  @@schema("ai")
}

model ToolExecution {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String?  @map("conversation_id") @db.Uuid
  toolName       String   @map("tool_name")
  actingSubject  String   @map("acting_subject") @db.Uuid
  argsJson       Json     @map("args_json")
  resultJson     Json?    @map("result_json")
  ok             Boolean
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([actingSubject, createdAt])
  @@index([toolName, createdAt])
  @@map("tool_executions")
  @@schema("ai")
}

model AiAuditEvent {
  id        String   @id @default(uuid()) @db.Uuid
  eventType String   @map("event_type")
  actorId   String?  @map("actor_id") @db.Uuid
  payload   Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([eventType, createdAt])
  @@map("ai_audit_events")
  @@schema("ai")
}

// ─── Notifications (ADR-0014) ────────────────────────────────────────────────

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP

  @@schema("notifications")
}

enum NotificationIntentStatus {
  PENDING
  PROCESSING
  DELIVERED
  FAILED
  CANCELLED

  @@schema("notifications")
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED

  @@schema("notifications")
}

model NotificationTemplate {
  id        String              @id @default(uuid()) @db.Uuid
  code      String
  channel   NotificationChannel
  locale    String              @default("en-KE")
  subject   String?
  body      String
  version   Int                 @default(1)
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([code, channel, locale, version])
  @@map("notification_templates")
  @@schema("notifications")
}

model NotificationIntent {
  id             String                   @id @default(uuid()) @db.Uuid
  type           String
  channel        NotificationChannel
  recipient      String
  templateCode   String                   @map("template_code")
  payloadJson    Json                     @map("payload_json")
  idempotencyKey String                   @unique @map("idempotency_key")
  status         NotificationIntentStatus @default(PENDING)
  availableAt    DateTime                 @default(now()) @map("available_at") @db.Timestamptz(3)
  attempts       Int                      @default(0)
  lastError      String?                  @map("last_error")
  createdAt      DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)

  deliveries NotificationDelivery[]

  @@index([status, availableAt])
  @@map("notification_intents")
  @@schema("notifications")
}

model NotificationDelivery {
  id           String                     @id @default(uuid()) @db.Uuid
  intentId     String                     @map("intent_id") @db.Uuid
  channel      NotificationChannel
  status       NotificationDeliveryStatus @default(PENDING)
  provider     String
  providerRef  String?                    @map("provider_ref")
  attemptKey   String                     @unique @map("attempt_key")
  responseJson Json?                      @map("response_json")
  sentAt       DateTime?                  @map("sent_at") @db.Timestamptz(3)
  createdAt    DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)

  intent NotificationIntent @relation(fields: [intentId], references: [id], onDelete: Cascade)

  @@index([intentId])
  @@map("notification_deliveries")
  @@schema("notifications")
}

model CommunicationPreference {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  channel   NotificationChannel
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([userId, channel])
  @@map("communication_preferences")
  @@schema("notifications")
}

// ─── API keys (M20 foundation) ───────────────────────────────────────────────

model ApiKey {
  id           String    @id @default(uuid()) @db.Uuid
  name         String
  keyPrefix    String    @map("key_prefix")
  keyHash      String    @map("key_hash")
  scopesJson   Json      @map("scopes_json")
  organizationId String? @map("organization_id") @db.Uuid
  createdBy    String?   @map("created_by") @db.Uuid
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  lastUsedAt   DateTime? @map("last_used_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([keyPrefix])
  @@index([keyHash])
  @@map("api_keys")
  @@schema("identity")
}
