{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": ["./base.json", "./paths.json"],
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "noEmit": true,
    "allowJs": false
  }
}
