{
  "name": "@buying-bot/product-sources",
  "version": "0.0.0",
  "private": true,
  "description": "Product source ports and marketplace connector adapters for Buying Bot Platform",
  "type": "module",
  "license": "UNLICENSED",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').cpSync('src/fixtures','dist/fixtures',{recursive:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@buying-bot/database": "workspace:*",
    "@buying-bot/validation": "workspace:*"
  },
  "devDependencies": {
    "@buying-bot/typescript-config": "workspace:*",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vitest": "^3.2.4"
  }
}
