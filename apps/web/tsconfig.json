{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": [
    "@buying-bot/typescript-config/base.json",
    "@buying-bot/typescript-config/paths.json"
  ],
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "outDir": "dist",
    "rootDir": "src",
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "noEmit": false
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
