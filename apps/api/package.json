{
  "name": "@buying-bot/api",
  "version": "0.0.0",
  "private": true,
  "description": "Backend API application shell",
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.build.json --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@buying-bot/ai-core": "workspace:^",
    "@buying-bot/auth": "workspace:^",
    "@buying-bot/config": "workspace:*",
    "@buying-bot/database": "workspace:^",
    "@buying-bot/product-sources": "workspace:^",
    "@buying-bot/types": "workspace:^",
    "@buying-bot/utils": "workspace:*",
    "@buying-bot/validation": "workspace:^",
    "@fastify/cookie": "^11",
    "@fastify/compress": "^8",
    "@fastify/helmet": "^13",
    "@nestjs/common": "^11",
    "@nestjs/core": "^11",
    "@nestjs/platform-fastify": "^11",
    "@node-rs/argon2": "^2.0.2",
    "fastify": "^5",
    "ioredis": "^6.0.0",
    "jose": "^6.2.8",
    "otpauth": "^9.5.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@buying-bot/typescript-config": "workspace:*",
    "@types/node": "^22.17.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
