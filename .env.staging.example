# Buying Bot Platform — STAGING environment template
# Copy to `.env.staging` (never commit). Placeholders only — no real secrets.
# EXTERNAL: replace all CHANGE_ME_* values before any shared staging host.

# --- Runtime ---
NODE_ENV=staging
LOG_LEVEL=info

# --- Staging Postgres (compose service `postgres`) ---
# EXTERNAL: strong unique credentials per staging environment
POSTGRES_USER=buyingbot_staging
POSTGRES_PASSWORD=CHANGE_ME_STAGING_PG_PASSWORD
POSTGRES_DB=buyingbot_staging
# Host-side URL used by migrate/seed/integrity scripts (port published by compose)
DATABASE_URL=postgresql://buyingbot_staging:CHANGE_ME_STAGING_PG_PASSWORD@127.0.0.1:5434/buyingbot_staging?schema=public

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- API ---
SERVICE_NAME=api
HOST=0.0.0.0
PORT=3000
# Staging must NOT use wildcard CORS. Comma-separated allowlist.
CORS_ORIGIN=https://staging.example.com,https://admin.staging.example.com
# EXTERNAL: generate with `openssl rand -base64 48` (min 32 chars)
SESSION_SECRET=CHANGE_ME_SESSION_SECRET_MIN_32_CHARS_LONG_VALUE
SERVICE_JWT_SECRET=CHANGE_ME_SERVICE_JWT_SECRET_MIN_32_CHARS
COOKIE_SECURE=true
CUSTOMER_SESSION_COOKIE=bb_cust_session
ADMIN_SESSION_COOKIE=bb_admin_session
CSRF_COOKIE=bb_csrf
GUEST_CART_COOKIE=bb_guest_cart

# Commerce
DEFAULT_CURRENCY=KES
TAX_REQUIRED=false
TAX_POLICY_CODE=DEFAULT
SHIPPING_DEFAULT_CODE=FLAT
# Keep false until EXTERNAL M-Pesa sandbox keys + callback URL are provisioned
PAYMENTS_ENABLED=false
# MPESA_ENV=sandbox
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=
# MPESA_PASSKEY=
# MPESA_CALLBACK_URL=https://staging.example.com/v1/webhooks/payments/mpesa
# MPESA_WEBHOOK_SECRET=

PRODUCT_CACHE_TTL_SECONDS=60

# --- Worker ---
# OUTBOX_POLL_INTERVAL_MS=5000
# RESERVATION_EXPIRE_INTERVAL_MS=30000
# PAYMENT_RECONCILE_INTERVAL_MS=60000

# --- AI service ---
AI_PROVIDER=deterministic
# EXTERNAL: set only when vendor keys are provisioned
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
API_BASE_URL=http://api:3000
AI_SERVICE_BASE_URL=http://ai-service:3003

# --- Frontends (browser-facing URLs) ---
# EXTERNAL: set to public staging origin once DNS exists
# PUBLIC_WEB_URL=https://staging.example.com
# PUBLIC_ADMIN_URL=https://admin.staging.example.com
# PUBLIC_API_URL=https://api.staging.example.com
# NEXT_PUBLIC_API_BASE_URL=https://api.staging.example.com
# CORS_ORIGIN=https://staging.example.com,https://admin.staging.example.com
WEB_BASE_URL=http://127.0.0.1:8080
ADMIN_BASE_URL=http://127.0.0.1:8080/admin

# --- Payments (Escrow only for customer UX) ---
PAYMENT_PROVIDER=escrow
PAYMENTS_ENABLED=false
# ESCROW_API_KEY=
# ESCROW_API_SECRET=
# ESCROW_BASE_URL=
# ESCROW_WEBHOOK_SECRET=

# --- Media (staging should use s3/minio, not laptop filesystem) ---
# MEDIA_DRIVER=s3
# S3_ENDPOINT=http://minio:9000
# S3_BUCKET=buyingbot-media
# S3_ACCESS_KEY_ID=   # alias: S3_ACCESS_KEY
# S3_SECRET_ACCESS_KEY=   # alias: S3_SECRET_KEY

# --- Nginx publish ports (local staging compose) ---
STAGING_HTTP_PORT=8080
# STAGING_HTTPS_PORT=8443
# EXTERNAL TLS cert paths (mounted into nginx) — see infrastructure/nginx/staging.conf
# TLS_CERT_PATH=/etc/nginx/certs/fullchain.pem
# TLS_KEY_PATH=/etc/nginx/certs/privkey.pem

# --- Catalog / marketplace (deferred) ---
# Shop catalog is admin-managed. Keep marketplace ingestion off unless explicitly enabling future work.
MARKETPLACE_INGESTION_ENABLED=false

# --- Observability (optional) ---
# OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Smoke / integrity scripts (host) ---
# API_BASE_URL for host-side smoke against published nginx or api port:
# API_BASE_URL=http://127.0.0.1:8080
