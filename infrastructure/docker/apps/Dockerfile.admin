# syntax=docker/dockerfile:1.7
# Multi-stage Next.js 15 admin portal image (standalone output).
# Build from repository root:
#   docker build -f infrastructure/docker/apps/Dockerfile.admin -t buying-bot-admin .
#
# Path-based staging: pass NEXT_PUBLIC_ADMIN_BASE_PATH=/admin at build time.
# EXTERNAL: full monorepo Next standalone builds can be heavy; prefer CI/GHCR
# images when a shared staging host is provisioned.

ARG NODE_VERSION=22

FROM node:${NODE_VERSION}-bookworm-slim AS base
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
ENV NEXT_TELEMETRY_DISABLED=1
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate
WORKDIR /app

FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.json ./
COPY packages ./packages
COPY apps/admin ./apps/admin
RUN pnpm install --frozen-lockfile --filter @buying-bot/admin...

FROM deps AS build
# Local defaults — staging compose overrides with public HTTPS + basePath=/admin.
ARG NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
ARG NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3001
ARG NEXT_PUBLIC_ADMIN_BASE_PATH=
ENV NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL
ENV NEXT_PUBLIC_STOREFRONT_URL=$NEXT_PUBLIC_STOREFRONT_URL
ENV NEXT_PUBLIC_ADMIN_BASE_PATH=$NEXT_PUBLIC_ADMIN_BASE_PATH
ENV DOCKER_BUILD=1
RUN pnpm --filter @buying-bot/admin... build

FROM node:${NODE_VERSION}-bookworm-slim AS runtime
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3004
ENV HOSTNAME=0.0.0.0
ENV INTERNAL_API_BASE_URL=http://api:3000
# Surfaced for healthcheck when the image was built with basePath=/admin.
ARG NEXT_PUBLIC_ADMIN_BASE_PATH=
ENV NEXT_PUBLIC_ADMIN_BASE_PATH=$NEXT_PUBLIC_ADMIN_BASE_PATH
WORKDIR /app
RUN groupadd --system --gid 1001 nodejs \
  && useradd --system --uid 1001 --gid nodejs nextjs
COPY --from=build /app/apps/admin/public ./apps/admin/public
COPY --from=build --chown=nextjs:nodejs /app/apps/admin/.next/standalone ./
COPY --from=build --chown=nextjs:nodejs /app/apps/admin/.next/static ./apps/admin/.next/static
USER nextjs
EXPOSE 3004
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "const b=process.env.NEXT_PUBLIC_ADMIN_BASE_PATH||''; const p=b.endsWith('/')?b.slice(0,-1):b; fetch('http://127.0.0.1:'+(process.env.PORT||3004)+p+'/').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "apps/admin/server.js"]
