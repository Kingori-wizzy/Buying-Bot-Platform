# Buying Bot Platform — environment variable template
# Copy to `.env` for local development. Never commit real secrets.

# Shared
# NODE_ENV is process-owned — do not set it in `.env` for Next.js apps (breaks `next build`).
# API/worker/ai-service set NODE_ENV when starting the process.
LOG_LEVEL=debug

# API (`apps/api`)
SERVICE_NAME=api
HOST=0.0.0.0
PORT=3000
# Production must set an explicit origin (never `*`). Comma-separated allowlist supported.
CORS_ORIGIN=http://localhost:3001,http://localhost:3004,http://127.0.0.1:3001,http://127.0.0.1:3004

# Admin MFA (TOTP). Default off — set true to require authenticator codes.
# ADMIN_MFA_REQUIRED=false

# Persistence (local compose defaults — change credentials for non-local)
DATABASE_URL=postgresql://buyingbot:buyingbot@127.0.0.1:5433/buyingbot?schema=public
DATABASE_URL_TEST=postgresql://buyingbot:buyingbot@127.0.0.1:5433/buyingbot_test?schema=public
REDIS_URL=redis://127.0.0.1:6380

# Auth / sessions (generate strong secrets locally; never commit real values)
SESSION_SECRET=dev-only-change-me-to-a-long-random-string
COOKIE_SECURE=false
CUSTOMER_SESSION_COOKIE=bb_cust_session
ADMIN_SESSION_COOKIE=bb_admin_session
CSRF_COOKIE=bb_csrf
GUEST_CART_COOKIE=bb_guest_cart
SERVICE_JWT_SECRET=dev-only-service-jwt-secret-change-me

# Commerce defaults (not hardcoded in schemas)
DEFAULT_CURRENCY=KES
TAX_REQUIRED=false
# TAX_DEFAULT_RATE_BPS=1600
TAX_POLICY_CODE=DEFAULT
SHIPPING_DEFAULT_CODE=FLAT
PAYMENTS_ENABLED=false
PAYMENT_PROVIDER=escrow

# Escrow (active customer payment rail — EXTERNAL PREREQUISITE)
# ESCROW_API_KEY=
# ESCROW_API_SECRET=
# ESCROW_BASE_URL=https://escrow.example.com
# ESCROW_WEBHOOK_SECRET=
# Local/dev only: allow pending test-double initiation without live keys (NEVER in staging/prod)
# ESCROW_ALLOW_TEST_DOUBLE=false
# For signed local webhook e2e, set the same secret in API + Playwright env:
# ESCROW_WEBHOOK_SECRET=e2e-escrow-webhook-secret-min-32-chars!!
# PUBLIC_API_BASE_URL=http://127.0.0.1:3000

# M-Pesa / Daraja — DEFERRED (not customer UX). Only if PAYMENT_PROVIDER=mpesa and MPESA_ENABLED=true
# MPESA_ENABLED=false
# MPESA_ENV=sandbox
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=
# MPESA_PASSKEY=
# MPESA_CALLBACK_URL=https://example.com/v1/webhooks/payments/mpesa
# MPESA_WEBHOOK_SECRET=

# Local media storage (dev). Production: MEDIA_DRIVER=s3 + MinIO/S3 (EXTERNAL).
# MEDIA_DRIVER=local
# MEDIA_LOCAL_ROOT=.data/media
# MEDIA_PUBLIC_BASE_URL=http://127.0.0.1:3000/v1/media/files
# MEDIA_MAX_BYTES=5242880
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_REGION=us-east-1
# S3_BUCKET=buyingbot-media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true

# Worker (`apps/worker`) — use a dedicated process env / compose service
# SERVICE_NAME=worker
# PORT=3002
# DATABASE_URL=postgresql://buyingbot:buyingbot@127.0.0.1:5433/buyingbot?schema=public
# OUTBOX_POLL_INTERVAL_MS=5000
# RESERVATION_EXPIRE_INTERVAL_MS=30000
# PAYMENT_RECONCILE_INTERVAL_MS=60000

# AI service (`apps/ai-service`)
# SERVICE_NAME=ai-service
# PORT=3003
AI_PROVIDER=deterministic
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OLLAMA_BASE_URL=http://127.0.0.1:11434
API_BASE_URL=http://127.0.0.1:3000
AI_SERVICE_BASE_URL=http://127.0.0.1:3003

# Observability (optional — no-op without endpoint)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318

# Marketplace product-source sync is DEFERRED. Shop catalog is admin-managed.
# MARKETPLACE_INGESTION_ENABLED=false

# Product cache TTL (seconds)
PRODUCT_CACHE_TTL_SECONDS=60

# Price freshness policy (minutes — discovery/display only; checkout always revalidates)
PRICE_FRESH_MINUTES=15
PRICE_RECENT_MINUTES=60
PRICE_EXPIRED_MINUTES=1440

# Real product sources (EXTERNAL_PREREQUISITE — do not invent credentials)
# JUMIA_SELLER_API_KEY=
# JUMIA_SELLER_API_SECRET=
# JUMIA_SELLER_API_BASE_URL=https://vendor-api.jumia.com
# KILIMALL_MERCHANT_FEED_URL=
# KILIMALL_MERCHANT_FEED_TOKEN=
# AFFILIATE_NETWORK_API_KEY=
# AFFILIATE_NETWORK_PUBLISHER_ID=

# Frontends (M13/M14 — Next.js App Router)
# Storefront `apps/web` → http://localhost:3001
# Admin `apps/admin` → http://localhost:3004 (must stay in CORS_ORIGIN above)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Future providers (do not set dummy production secrets)
# STRIPE_SECRET_KEY=
