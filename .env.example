# Buying Bot Platform — environment variable template
# Copy to `.env` for local development. Never commit real secrets.

# Shared
NODE_ENV=development
LOG_LEVEL=debug

# API (`apps/api`)
SERVICE_NAME=api
HOST=0.0.0.0
PORT=3000
# Production must set an explicit origin (never `*`)
CORS_ORIGIN=http://localhost:3001

# Worker (`apps/worker`) — use a dedicated process env / compose service
# SERVICE_NAME=worker
# PORT=3002

# AI service (`apps/ai-service`)
# SERVICE_NAME=ai-service
# PORT=3003

# Future (do not set dummy production secrets)
# DATABASE_URL=
# REDIS_URL=
# SESSION_SECRET=
# OPENAI_API_KEY=
# STRIPE_SECRET_KEY=
# MPESA_CONSUMER_KEY=
