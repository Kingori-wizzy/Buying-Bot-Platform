# Buying Bot Platform — environment variable template
# Copy to `.env` for local development. Never commit real secrets.

# Shared
# NODE_ENV is process-owned — do not set it in `.env` for Next.js apps (breaks `next build`).
# API/worker/ai-service set NODE_ENV when starting the process.
LOG_LEVEL=debug

# API (`apps/api`)
SERVICE_NAME=api
HOST=0.0.0.0
PORT=3000
# Production must set an explicit origin (never `*`). Comma-separated allowlist supported.
CORS_ORIGIN=http://localhost:3001,http://localhost:3004

# Persistence (local compose defaults — change credentials for non-local)
DATABASE_URL=postgresql://buyingbot:buyingbot@127.0.0.1:5433/buyingbot?schema=public
DATABASE_URL_TEST=postgresql://buyingbot:buyingbot@127.0.0.1:5433/buyingbot_test?schema=public
REDIS_URL=redis://127.0.0.1:6379

# Auth / sessions (generate strong secrets locally; never commit real values)
SESSION_SECRET=dev-only-change-me-to-a-long-random-string
COOKIE_SECURE=false
CUSTOMER_SESSION_COOKIE=bb_cust_session
ADMIN_SESSION_COOKIE=bb_admin_session
CSRF_COOKIE=bb_csrf
GUEST_CART_COOKIE=bb_guest_cart
SERVICE_JWT_SECRET=dev-only-service-jwt-secret-change-me

# Commerce defaults (not hardcoded in schemas)
DEFAULT_CURRENCY=KES
TAX_REQUIRED=false
# TAX_DEFAULT_RATE_BPS=1600
TAX_POLICY_CODE=DEFAULT
SHIPPING_DEFAULT_CODE=FLAT
PAYMENTS_ENABLED=false

# M-Pesa / Daraja (sandbox placeholders — never commit real secrets)
# MPESA_ENV=sandbox
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=
# MPESA_PASSKEY=
# MPESA_CALLBACK_URL=https://example.com/v1/webhooks/payments/mpesa
# MPESA_WEBHOOK_SECRET=

# Worker (`apps/worker`) — use a dedicated process env / compose service
# SERVICE_NAME=worker
# PORT=3002
# DATABASE_URL=postgresql://buyingbot:buyingbot@127.0.0.1:5433/buyingbot?schema=public
# OUTBOX_POLL_INTERVAL_MS=5000
# RESERVATION_EXPIRE_INTERVAL_MS=30000
# PAYMENT_RECONCILE_INTERVAL_MS=60000

# AI service (`apps/ai-service`)
# SERVICE_NAME=ai-service
# PORT=3003
AI_PROVIDER=deterministic
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OLLAMA_BASE_URL=http://127.0.0.1:11434
API_BASE_URL=http://127.0.0.1:3000
AI_SERVICE_BASE_URL=http://127.0.0.1:3003

# Observability (optional — no-op without endpoint)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318

# Product cache TTL (seconds)
PRODUCT_CACHE_TTL_SECONDS=60

# Frontends (M13/M14 — Next.js App Router)
# Storefront `apps/web` → http://localhost:3001
# Admin `apps/admin` → http://localhost:3004 (must stay in CORS_ORIGIN above)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Future providers (do not set dummy production secrets)
# STRIPE_SECRET_KEY=
